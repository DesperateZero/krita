# Windows batch files must be in CRLF to not make cmd.exe freak out
*.cmd text eol=crlf
*.bat text eol=crlf

# Make sure Windows .lnk shortcuts are binary
*.lnk binary

# Patch files must be checked out in CRLF on Windows for patch to work
*.patch text=auto
*.diff text=auto

# Keep the vendored VMA header byte-for-byte compatible with its upstream
# release; its upstream formatting intentionally contains trailing spaces.
3rdparty_vendor/vma/include/vk_mem_alloc.h -whitespace
